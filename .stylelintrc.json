{
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "use",
          "forward",
          "mixin",
          "include",
          "function",
          "return",
          "if",
          "else",
          "each",
          "for",
          "while",
          "content",
          "debug",
          "warn",
          "error",
          "extend",
          "charset",
          "sourcemap",
          "import",
          "at-root",
          "else"
        ]
      }
    ],
    "declaration-block-no-duplicate-properties": true,
    "max-nesting-depth": 4
  }
}

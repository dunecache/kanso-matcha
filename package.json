{
  "name": "kanso-matcha",
  "version": "0.0.1",
  "private": true,
  "description": "A quiet, warm digital notebook theme for Obsidian — Minimal × Zen × Wabi-Sabi × Matcha.",
  "scripts": {
    "dev": "sass --watch styles/index.scss:theme.css --style=expanded --no-source-map",
    "build": "sass --no-source-map styles/index.scss:theme.css --style=expanded",
    "fonts": "python3 scripts/generate-fonts.py",
    "validate": "stylelint \"styles/**/*.scss\" \"theme.css\""
  },
  "devDependencies": {
    "sass": "^1.83.0",
    "stylelint": "^16.10.0"
  }
}
